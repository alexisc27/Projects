{
  "name": "therapy-app",
  "version": "1.0.0",
  "private": true,
  "description": "Therapy management system: therapists, clients and sessions (React + Express + MySQL)",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run server\" \"npm start\"",
    "server": "nodemon server/index.js",
    "start": "react-scripts start",
    "build": "react-scripts build"
  },
  "dependencies": {
    "axios": "1.7.7",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "mysql2": "3.11.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "react-scripts": "5.0.1",
    "sequelize": "6.37.5"
  },
  "devDependencies": {
    "concurrently": "9.1.0",
    "nodemon": "3.1.7"
  },
  "eslintConfig": {
    "extends": ["react-app"]
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  },
  "nodemonConfig": {
    "watch": ["server"]
  }
}
